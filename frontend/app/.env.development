# npm run dev. Vite reads .env.[mode] (development, production, test) and only passes VITE_* variables to the app.
# They end up in the browser code: never put a secret here. Personal overrides go in .env.development.local (ignored by git).

# 'mock' answers every request in the browser (src/lib/mock/); 'real' calls the Spring Boot services.
# The dev bar can still switch to the mock.
VITE_API_MODE=real
VITE_APP_SERVICE_URL=http://localhost:8080
VITE_AUTH_SERVICE_URL=http://localhost:8081
